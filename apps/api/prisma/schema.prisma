// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User Model - ユーザー情報
// ============================================
model User {
  id                String   @id @default(uuid())
  email             String   @unique
  username          String   @unique
  passwordHash      String   @map("password_hash")
  fullName          String?  @map("full_name")
  avatarUrl         String?  @map("avatar_url")
  timezone          String   @default("UTC")
  language          String   @default("en")
  emailVerified     Boolean  @default(false) @map("email_verified")
  isActive          Boolean  @default(true) @map("is_active")
  subscriptionTier  String   @default("free") @map("subscription_tier") // free, pro, enterprise
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  lastLoginAt       DateTime? @map("last_login_at")

  // Relations
  dataSources          DataSource[]
  notificationRules    NotificationRule[]
  notificationHistory  NotificationHistory[]
  apiKeys              ApiKey[]

  @@map("users")
  @@index([email])
  @@index([username])
}

// ============================================
// DataSource Model - 情報ソース設定
// ============================================
model DataSource {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  name           String
  type           String    // rss, twitter, web, news_api, webhook
  config         Json      // Source-specific configuration
  isActive       Boolean   @default(true) @map("is_active")
  checkInterval  Int       @default(300) @map("check_interval") // in seconds
  lastCheckedAt  DateTime? @map("last_checked_at")
  lastSuccessAt  DateTime? @map("last_success_at")
  errorCount     Int       @default(0) @map("error_count")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectedData CollectedData[]

  @@map("data_sources")
  @@index([userId])
  @@index([type])
  @@index([isActive])
  @@index([lastCheckedAt])
}

// ============================================
// NotificationRule Model - 通知ルール
// ============================================
model NotificationRule {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  description     String?
  // Filter conditions
  keywords        String[] // Keywords to match
  excludeKeywords String[] @map("exclude_keywords") // Keywords to exclude
  sourceTypes     String[] @map("source_types") // Source types to monitor
  priority        Int      @default(0) // Higher = more important
  // Notification settings
  channels        Json     // Email, Push, Webhook, Desktop
  schedule        Json?    // When to send notifications
  quietHours      Json?    @map("quiet_hours") // Silent hours
  batchEnabled    Boolean  @default(false) @map("batch_enabled")
  batchInterval   Int?     @map("batch_interval") // in minutes
  maxPerBatch     Int?     @map("max_per_batch")
  // Status
  isActive        Boolean  @default(true) @map("is_active")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  triggerCount    Int      @default(0) @map("trigger_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationHistory NotificationHistory[]

  @@map("notification_rules")
  @@index([userId])
  @@index([isActive])
  @@index([priority])
}

// ============================================
// CollectedData Model - 収集データ
// ============================================
model CollectedData {
  id            String    @id @default(uuid())
  dataSourceId  String    @map("data_source_id")
  // Content information
  title         String
  content       String    @db.Text
  summary       String?   @db.Text
  url           String    @unique
  author        String?
  publishedAt   DateTime? @map("published_at")
  // Metadata
  language      String?
  tags          String[]
  categories    String[]
  // Analysis (will be populated by workers)
  sentiment     Float?    // -1 to 1
  keywords      String[]
  entities      String[]
  // Media
  imageUrl      String?   @map("image_url")
  videoUrl      String?   @map("video_url")
  // Processing status
  isProcessed   Boolean   @default(false) @map("is_processed")
  notified      Boolean   @default(false)
  notifiedAt    DateTime? @map("notified_at")
  // Timestamps
  collectedAt   DateTime  @default(now()) @map("collected_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  dataSource          DataSource            @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  notificationHistory NotificationHistory[]

  @@map("collected_data")
  @@index([dataSourceId])
  @@index([collectedAt])
  @@index([isProcessed])
  @@index([notified])
  @@index([publishedAt])
}

// ============================================
// NotificationHistory Model - 通知履歴
// ============================================
model NotificationHistory {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  notificationRuleId String?   @map("notification_rule_id")
  collectedDataId    String    @map("collected_data_id")
  // Notification details
  channel            String    // email, push, webhook, desktop
  status             String    // pending, sent, failed, read
  recipient          String?   // Email address, device ID, etc.
  subject            String?
  message            String?   @db.Text
  metadata           Json?
  // Delivery information
  sentAt             DateTime? @map("sent_at")
  readAt             DateTime? @map("read_at")
  failedAt           DateTime? @map("failed_at")
  errorMessage       String?   @map("error_message")
  retryCount         Int       @default(0) @map("retry_count")
  // Timestamps
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationRule NotificationRule? @relation(fields: [notificationRuleId], references: [id], onDelete: SetNull)
  collectedData    CollectedData     @relation(fields: [collectedDataId], references: [id], onDelete: Cascade)

  @@map("notification_history")
  @@index([userId])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@index([sentAt])
}

// ============================================
// ApiKey Model - API キー管理
// ============================================
model ApiKey {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  keyHash     String    @unique @map("key_hash")
  name        String
  permissions Json
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
  @@index([userId])
  @@index([keyHash])
}
