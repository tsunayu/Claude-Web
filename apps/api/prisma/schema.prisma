// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  username          String   @unique
  passwordHash      String   @map("password_hash")
  fullName          String?  @map("full_name")
  avatarUrl         String?  @map("avatar_url")
  timezone          String   @default("UTC")
  language          String   @default("en")
  emailVerified     Boolean  @default(false) @map("email_verified")
  isActive          Boolean  @default(true) @map("is_active")
  subscriptionTier  String   @default("free") @map("subscription_tier")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  lastLoginAt       DateTime? @map("last_login_at")

  sources              Source[]
  filters              Filter[]
  notificationsConfig  NotificationConfig[]
  notificationsLog     NotificationLog[]
  apiKeys              ApiKey[]

  @@map("users")
}

model Source {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  name           String
  type           String   // rss, twitter, web, news_api, webhook
  config         Json     // Source-specific configuration
  isActive       Boolean  @default(true) @map("is_active")
  checkInterval  Int      @default(300) @map("check_interval") // in seconds
  lastCheckedAt  DateTime? @map("last_checked_at")
  errorCount     Int      @default(0) @map("error_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isActive])
  @@map("sources")
}

model Filter {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  conditions  Json     // Filter conditions with AND/OR logic
  priority    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationsConfig NotificationConfig[]

  @@index([userId])
  @@map("filters")
}

model NotificationConfig {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  filterId    String   @map("filter_id")
  channels    Json     // Notification channels configuration
  schedule    Json?    // Notification schedule
  quietHours  Json?    @map("quiet_hours") // Silent hours
  batchConfig Json?    @map("batch_config") // Batch notification config
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  filter           Filter            @relation(fields: [filterId], references: [id], onDelete: Cascade)
  notificationsLog NotificationLog[]

  @@index([userId])
  @@index([filterId])
  @@map("notifications_config")
}

model NotificationLog {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  configId  String?   @map("config_id")
  contentId String    @map("content_id") // MongoDB content ID
  channel   String    // email, push, webhook, desktop
  status    String    // pending, sent, failed, read
  metadata  Json?
  sentAt    DateTime? @map("sent_at")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  config NotificationConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("notifications_log")
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  keyHash     String    @unique @map("key_hash")
  name        String
  permissions Json
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}
